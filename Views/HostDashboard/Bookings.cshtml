@model IEnumerable<Booking>
@{ ViewData["Title"] = "Booking requests"; }
<h1>Booking requests</h1><table><thead><tr><th>Property</th><th>Guest</th><th>Dates</th><th>Total</th><th>Status</th><th>Update</th></tr></thead><tbody>
@foreach (var b in Model) { <tr><td>@b.Property?.Title</td><td>@b.Guest?.Email</td><td>@b.CheckIn.ToString("d") – @b.CheckOut.ToString("d")</td><td>R @b.TotalPrice.ToString("N2")</td><td>@b.Status</td><td>
@foreach (var s in new[]{"Approved","Rejected"}) { <form asp-action="UpdateBooking" method="post" class="inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@b.Id" /><input type="hidden" name="status" value="@s" /><button>@s</button></form> }
</td></tr> }</tbody></table>
