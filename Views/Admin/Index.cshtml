@model IEnumerable<ActivityLog>
@{ ViewData["Title"] = "Admin dashboard"; }
<h1>Admin dashboard</h1><div class="stats"><div><strong>@ViewBag.PendingApplications</strong><span>Pending host applications</span></div><div><strong>@ViewBag.PendingBookings</strong><span>Pending bookings</span></div></div>
<p><a asp-action="Applications">Review host applications</a> · <a asp-action="Documents">Guest documents</a> · <a asp-action="Messages">All messages</a>
@if (User.IsInRole("SuperAdmin")) { <text> · <a asp-action="Users">Manage users</a></text> }</p>
<h2>Recent activity log</h2><table><thead><tr><th>Date</th><th>User ID</th><th>Action</th><th>Details</th></tr></thead><tbody>@foreach (var a in Model) { <tr><td>@a.CreatedAt.ToLocalTime()</td><td>@a.UserId</td><td>@a.Action</td><td>@a.Details</td></tr> }</tbody></table>
