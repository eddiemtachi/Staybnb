@model IEnumerable<Message>
@{ ViewData["Title"] = "System messages"; }
<h1>System messages</h1><table><thead><tr><th>Sent</th><th>From</th><th>To</th><th>Message</th><th>Read</th></tr></thead><tbody>@foreach (var m in Model) { <tr><td>@m.SentAt.ToLocalTime()</td><td>@m.Sender?.Email</td><td>@m.Recipient?.Email</td><td>@m.Body</td><td>@m.IsRead</td></tr> }</tbody></table>
