@model IEnumerable<GuestDocument>
@{ ViewData["Title"] = "Guest documents"; }
<h1>Guest documents</h1><table><thead><tr><th>Booking</th><th>Type</th><th>Document link</th><th>Status</th><th>Review</th></tr></thead><tbody>@foreach (var d in Model) { <tr><td>@d.BookingId</td><td>@d.DocumentType</td><td><a href="@d.DocumentUrl" target="_blank" rel="noopener">Open document</a></td><td>@d.Status</td><td>@foreach (var s in new[]{"Verified","Rejected"}) { <form asp-action="ReviewDocument" method="post" class="inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@d.Id" /><input type="hidden" name="status" value="@s" /><button>@s</button></form> }</td></tr> }</tbody></table>
